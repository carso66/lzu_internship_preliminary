<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.marketplace.mapper.ProductMapper">

    <sql id="productFilters">
        <where>
            <if test="keyword != null and keyword != ''">
                AND title LIKE CONCAT('%', #{keyword}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
        </where>
    </sql>

    <insert id="insert" parameterType="com.example.marketplace.domain.Product"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO products (title, price, stock, category, description, seller_name, status)
        VALUES (#{title}, #{price}, #{stock}, #{category}, #{description}, #{sellerName}, #{status})
    </insert>

    <select id="findById" resultType="com.example.marketplace.domain.Product">
        SELECT id, title, price, stock, category, description, seller_name, status, created_at
        FROM products
        WHERE id = #{id}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM products
        <include refid="productFilters"/>
    </select>

    <select id="findPage" resultType="com.example.marketplace.domain.Product">
        SELECT id, title, price, stock, category, description, seller_name, status, created_at
        FROM products
        <include refid="productFilters"/>
        ORDER BY id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
